PORT=4000

CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

POSTGRES_USER=knowledge_hub_user
POSTGRES_PASSWORD=knowledge_hub_password
POSTGRES_DB=knowledge_hub
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://knowledge_hub_user:knowledge_hub_password@localhost:5432/knowledge_hub?schema=public&connection_limit=10&pool_timeout=20

LOG_LEVEL=log
LOG_MAX_FILE_SIZE=1024

GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash
GEMINI_HTTP_TIMEOUT_MS=120000
AI_RATE_LIMIT_RPM=20
AI_CACHE_TTL_SEC=300

GEMINI_EMBEDDING_MODEL=text-embedding-004
RAG_VECTOR_DB_PROVIDER=qdrant
RAG_VECTOR_DB_URL=http://vectordb:6333
RAG_VECTOR_COLLECTION=knowledge_hub_articles
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200
RAG_CONVERSATION_MAX_MESSAGES=20
